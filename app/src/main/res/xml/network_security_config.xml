<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Jellyfin on the home LAN is plain HTTP to an address Eric types in. Android's domain rules do not match that IP, so cleartext is allowed. The TV remote stays TLS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <!-- Allow self-signed certs for Android TV Remote protocol -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">192.168.10.105</domain>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
