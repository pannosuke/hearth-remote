<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Jellyfin is plain HTTP to whatever host is typed in Settings, including a private LAN address such as 192.168.10.114. Domain rules do not match an IP literal, so cleartext is allowed for every host except the TV below. The TV remote stays TLS. The Jellyfin client also opens its own socket for http, so this policy cannot block that sign-in. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <!-- Allow self-signed certs for Android TV Remote protocol -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">192.168.10.105</domain>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
